# Required for Menso models, embeddings, and Realtime client-secret minting.
OPENAI_API_KEY=

# Production is fail closed. Use either a PEM verification key or a static JWKS file.
RUNTIME_ENV=prd
OS_ID=menso-os
JWT_ALGORITHM=RS256
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json
# For local authenticated testing, run ./scripts/generate_local_auth.sh.
# Docker Compose then loads .local-auth/runtime.env, which points at the
# generated ignored JWKS file and keeps all signing material out of this file.

# Comma-separated verified JWT subjects allowed to start AgentImprovementWorkflow.
MENSO_ADMIN_USER_IDS=

# Scheduler and public metadata. Production AGENTOS_PUBLIC_URL must be HTTPS.
# Railway up.sh derives both from the created domain when these are blank.
AGENTOS_URL=
AGENTOS_PUBLIC_URL=

# Realtime uses a short-lived client token; this high-entropy salt HMACs JWT subjects.
# Never reuse a public identifier or send the raw subject to OpenAI.
MENSO_SAFETY_IDENTIFIER_SALT=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low

# Fixed server models.
MENSO_MODEL_ID=gpt-5.6-sol
MENSO_EXECUTOR_MODEL_ID=gpt-5.6-sol

# Schedules. Evals are opt-in; improvement is explicit-admin-only and always scheduled disabled.
EVAL_SCHEDULE_ENABLED=False
EVAL_SCHEDULE_CRON="0 5 * * 1"
IMPROVEMENT_SCHEDULE_CRON="0 4 * * 1"
EVALS_TAG=smoke
EVALS_CASE_TIMEOUT_SECONDS=90
EVALS_SUITE_TIMEOUT_SECONDS=300

# PostgreSQL / pgvector. DATABASE_URL takes precedence when present.
# DATABASE_URL=postgresql+psycopg://menso:menso@localhost:5432/menso
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_USER=menso
DB_PASS=
DB_DATABASE=menso

AGNO_DEBUG=False
WAIT_FOR_DB=False
