# Required for GPT-Live voice sessions.
OPENAI_API_KEY=

# Server-only key for bounded Mac action selection (no Agno reasoning agent).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Production is fail closed. Use either a PEM verification key or a static JWKS file.
RUNTIME_ENV=prd
OS_ID=menso-os
JWT_ALGORITHM=RS256
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json
# For local authenticated testing, run ./scripts/generate_local_auth.sh.
# Docker Compose then loads .local-auth/runtime.env, which points at the
# generated ignored JWKS file and keeps all signing material out of this file.

# Public metadata. Production AGENTOS_PUBLIC_URL must be HTTPS.
# Railway up.sh derives both from the created domain when these are blank.
AGENTOS_URL=
AGENTOS_PUBLIC_URL=

# This high-entropy salt HMACs verified JWT subjects for provider safety identifiers.
# Never reuse a public identifier or send the raw subject to OpenAI.
MENSO_SAFETY_IDENTIFIER_SALT=
OPENAI_LIVE_MODEL=gpt-live-1

# PostgreSQL. DATABASE_URL takes precedence when present.
# DATABASE_URL=postgresql+psycopg://menso:menso@localhost:5432/menso
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_USER=menso
DB_PASS=
DB_DATABASE=menso

AGNO_DEBUG=False
WAIT_FOR_DB=False
